{
  "name": "csnews",
  "version": "1.0.0",
  "private": true,
  "description": "一对一家教微信小程序 - C2C 家教撮合平台",
  "scripts": {
    "dev:server": "npm run start:dev --prefix apps/server",
    "dev:admin": "npm run dev --prefix apps/admin",
    "build:server": "npm run build --prefix apps/server",
    "build:admin": "npm run build --prefix apps/admin",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "setup": "cd apps/server && npm install && cd ../admin && npm install"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
