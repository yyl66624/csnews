/* 骨架屏 — 微光（shimmer）动画 */

/* 所有骨架线条共用 */
.sk-line {
  background: linear-gradient(90deg, #eee 25%, #f5f5f5 50%, #eee 75%);
  background-size: 200% 100%;
  animation: shimmer 1.4s ease-in-out infinite;
  border-radius: 8rpx;
}

@keyframes shimmer {
  0%   { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}

/* 卡片容器 */
.sk-card { background: #fff; border-radius: 16rpx; padding: 24rpx; margin-bottom: 20rpx; }
.sk-card-list { /* wrapper for card skeletons */ }

/* 布局 */
.sk-row { display: flex; align-items: center; padding: 16rpx 0; gap: 16rpx; }
.sk-body { flex: 1; display: flex; flex-direction: column; gap: 12rpx; }

/* 形状 */
.sk-avatar    { width: 96rpx; height: 96rpx; border-radius: 50%; flex-shrink: 0; }
.sk-avatar-lg { width: 128rpx; height: 128rpx; border-radius: 50%; flex-shrink: 0; }
.sk-title     { width: 60%; height: 32rpx; }
.sk-title-lg  { width: 70%; height: 36rpx; }
.sk-meta      { width: 85%; height: 24rpx; }
.sk-meta-short{ width: 50%; height: 24rpx; }
.sk-tags      { width: 40%; height: 24rpx; }
.sk-heading   { width: 40%; height: 30rpx; margin-bottom: 8rpx; }
.sk-full       { width: 100%; height: 24rpx; }
.sk-full-short { width: 65%; height: 24rpx; }
