page {
  background-color: #f5f6fa;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  font-size: 28rpx;
  color: #333;
  box-sizing: border-box;
}

.container {
  padding: 24rpx;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.btn-primary {
  background: linear-gradient(135deg, #4a90d9, #357abd);
  color: #fff;
  border: none;
  border-radius: 44rpx;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 32rpx;
}

.btn-primary[disabled] {
  opacity: 0.6;
}

.tag {
  display: inline-block;
  padding: 4rpx 16rpx;
  background: #eef4fc;
  color: #4a90d9;
  border-radius: 8rpx;
  font-size: 24rpx;
  margin-right: 12rpx;
}

.price {
  color: #e74c3c;
  font-weight: bold;
}

.price-unit {
  font-size: 24rpx;
}

.empty {
  text-align: center;
  padding: 80rpx 0;
  color: #999;
}

.flex-row {
  display: flex;
  align-items: center;
}

.flex-between {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #eee;
}

.rating {
  color: #f5a623;
  font-size: 24rpx;
}
