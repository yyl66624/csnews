/* ========================================
   优学家教 — 全局样式
   ======================================== */

/* ---------- 基础 ---------- */
page {
  background-color: #f5f6fa;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  font-size: 28rpx;
  color: #333;
  box-sizing: border-box;
}

/* 页面进入动画 */
page {
  animation: pageFadeIn 280ms cubic-bezier(0.11, 0.0, 0.11, 1.0) both;
}

@keyframes pageFadeIn {
  from { opacity: 0; transform: translateY(12rpx); }
  to   { opacity: 1; transform: translateY(0); }
}

.container {
  padding: 24rpx;
}

/* ---------- 卡片 ---------- */
.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
  transition: transform 120ms ease, box-shadow 120ms ease;
}

/* 卡片交互反馈（配合 touch 事件或 hover-class） */
.card:active,
.card-hover {
  transform: scale(0.985);
  box-shadow: 0 1rpx 6rpx rgba(0, 0, 0, 0.04);
}

/* ---------- 按钮 ---------- */
.btn-primary {
  background: linear-gradient(135deg, #4a90d9, #357abd);
  color: #fff;
  border: none;
  border-radius: 44rpx;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 32rpx;
  transition: opacity 160ms ease, transform 120ms ease;
}

.btn-primary:active {
  opacity: 0.85;
  transform: scale(0.97);
}

.btn-primary[disabled] {
  opacity: 0.5;
  transform: none;
}

/* loading 态按钮 */
.btn-loading {
  opacity: 0.7;
  pointer-events: none;
}

/* ---------- 标签 ---------- */
.tag {
  display: inline-block;
  padding: 4rpx 16rpx;
  background: #eef4fc;
  color: #4a90d9;
  border-radius: 8rpx;
  font-size: 24rpx;
  margin-right: 12rpx;
  transition: background 160ms ease, color 160ms ease;
}

.tag.active {
  background: #4a90d9;
  color: #fff;
}

/* ---------- 价格 ---------- */
.price {
  color: #e74c3c;
  font-weight: bold;
}

.price-unit {
  font-size: 24rpx;
}

/* ---------- 空态 & 错误 ---------- */
.empty {
  text-align: center;
  padding: 80rpx 0;
  color: #999;
}

.empty-icon {
  font-size: 80rpx;
  display: block;
  margin-bottom: 16rpx;
  opacity: 0.4;
}

.error-tip {
  text-align: center;
  padding: 40rpx;
  color: #e74c3c;
  font-size: 26rpx;
}

.retry-btn {
  display: inline-block;
  margin-top: 20rpx;
  padding: 14rpx 40rpx;
  color: #4a90d9;
  border: 1rpx solid #4a90d9;
  border-radius: 44rpx;
  font-size: 26rpx;
}

/* ---------- 布局工具 ---------- */
.flex-row {
  display: flex;
  align-items: center;
}

.flex-between {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

/* ---------- 头像 ---------- */
.avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #eee;
}

/* ---------- 评分 ---------- */
.rating {
  color: #f5a623;
  font-size: 24rpx;
}

/* ---------- section 标题 ---------- */
.section-title {
  font-size: 30rpx;
  font-weight: bold;
  margin-bottom: 16rpx;
}

/* ---------- 通用动画混入（JS 控制时用 class 切换） ---------- */
.anim-fade-in {
  animation: fadeIn 300ms cubic-bezier(0.11, 0.0, 0.11, 1.0) both;
}

.anim-slide-up {
  animation: slideUp 350ms cubic-bezier(0.11, 0.0, 0.11, 1.0) both;
}

@keyframes fadeIn {
  from { opacity: 0; }
  to   { opacity: 1; }
}

@keyframes slideUp {
  from { opacity: 0; transform: translateY(24rpx); }
  to   { opacity: 1; transform: translateY(0); }
}
