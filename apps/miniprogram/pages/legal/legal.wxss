.container {
  padding: 24rpx;
  padding-bottom: 48rpx;
}

.updated {
  color: #999;
  font-size: 24rpx;
  margin-bottom: 24rpx;
}

.section {
  margin-bottom: 24rpx;
  padding: 28rpx;
}

.heading {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 16rpx;
}

.body {
  font-size: 28rpx;
  color: #666;
  line-height: 1.7;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}
