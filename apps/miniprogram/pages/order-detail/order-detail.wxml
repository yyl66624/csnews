<!-- 骨架屏 -->
<skeleton wx:if="{{!order}}" type="card" count="2" />

<view class="container" wx:if="{{order}}">
  <view class="card anim-slide-up">
    <view class="status-big">{{statusMap[order.status]}}</view>
    <view class="order-no">订单号：{{order.orderNo}}</view>
  </view>

  <view class="card anim-slide-up">
    <view class="row"><text class="label">科目</text><text>{{order.subject}} · {{order.gradeLevel}}</text></view>
    <view class="row"><text class="label">时间</text><text>{{order.lessonDate}} {{order.startTime}}-{{order.endTime}}</text></view>
    <view class="row"><text class="label">教师</text><text>{{teacherName}}</text></view>
    <view class="row"><text class="label">课时费</text><text>¥{{order.lessonFee}}</text></view>
    <view class="row"><text class="label">服务费</text><text>¥{{order.serviceFee}}</text></view>
    <view class="row total"><text class="label">合计</text><text class="price">¥{{order.totalAmount}}</text></view>
  </view>

  <button wx:if="{{order.status === 'pending' || order.status === 'confirmed'}}" class="btn-cancel" bindtap="cancelOrder">取消订单</button>
  <button wx:if="{{order.status === 'completed'}}" class="btn-primary" bindtap="goReview">去评价</button>
</view>
