<view class="container">
  <view class="profile-header card" wx:if="{{userInfo}}">
    <image class="avatar-lg" src="{{userInfo.avatarUrl || '/assets/icons/user.png'}}" mode="aspectFill" />
    <view class="profile-info">
      <view class="name">{{userInfo.nickname}}</view>
      <view class="role">{{isTeacher ? '教师' : '学生/家长'}}</view>
      <view class="phone" wx:if="{{userInfo.phone}}">{{userInfo.phone}}</view>
    </view>
  </view>

  <view class="profile-header card" wx:else>
    <button class="btn-primary login-btn" bindtap="onLogin">微信一键登录</button>
  </view>

  <view class="menu card" wx:if="{{userInfo}}">
    <view class="menu-item" wx:if="{{!isTeacher}}" bindtap="goTeacherApply">
      <text>成为教师</text><text class="arrow">›</text>
    </view>
    <view class="menu-item" wx:if="{{isTeacher}}" bindtap="goTeacherHome">
      <text>教师中心</text><text class="arrow">›</text>
    </view>
    <view class="menu-item" bindtap="logout">
      <text class="logout-text">退出登录</text><text class="arrow">›</text>
    </view>
  </view>
</view>
