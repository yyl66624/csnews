.section-title { font-size: 30rpx; font-weight: bold; margin-bottom: 16rpx; }
.rating-text { color: #f5a623; font-size: 32rpx; }
.tags { display: flex; flex-wrap: wrap; gap: 12rpx; }
.tag { padding: 8rpx 20rpx; background: #f0f0f0; border-radius: 8rpx; font-size: 26rpx; }
.tag.active { background: #4a90d9; color: #fff; }
textarea { width: 100%; height: 200rpx; padding: 16rpx; background: #f9f9f9; border-radius: 8rpx; box-sizing: border-box; }
.btn-primary { margin-top: 32rpx; }
