<view class="container">
  <!-- 空态 -->
  <view wx:if="{{orders.length === 0}}" class="empty">
    <text class="empty-icon">📋</text>
    <text>暂无订单</text>
  </view>

  <!-- 订单列表 -->
  <view wx:for="{{orders}}" wx:key="id" class="card anim-slide-up">
    <view class="flex-between">
      <text>{{item.subject}} · {{item.gradeLevel}}</text>
      <text class="status">{{statusMap[item.status]}}</text>
    </view>
    <view class="info">{{item.lessonDate}} {{item.startTime}}-{{item.endTime}}</view>
    <view class="info">学生：{{item.studentName}} · ¥{{item.lessonFee}}</view>
    <view class="actions" wx:if="{{item.status === 'pending'}}">
      <button size="mini" type="primary" data-id="{{item.id}}" bindtap="confirm">接单</button>
      <button size="mini" data-id="{{item.id}}" bindtap="reject">拒单</button>
    </view>
    <view class="actions" wx:if="{{item.status === 'confirmed'}}">
      <button size="mini" type="primary" data-id="{{item.id}}" bindtap="start">开始上课</button>
      <button size="mini" data-id="{{item.id}}" bindtap="complete">确认完成</button>
    </view>
    <view class="actions" wx:if="{{item.status === 'in_progress'}}">
      <button size="mini" type="primary" data-id="{{item.id}}" bindtap="complete">确认完成</button>
    </view>
  </view>
</view>
