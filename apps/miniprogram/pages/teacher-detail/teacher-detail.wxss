.avatar-lg { width: 128rpx; height: 128rpx; border-radius: 50%; background: #eee; }
.header-info { flex: 1; margin-left: 24rpx; }
.name { font-size: 36rpx; font-weight: bold; }
.bio { margin-top: 20rpx; color: #666; line-height: 1.6; }
.style-tag { margin-top: 12rpx; color: #4a90d9; font-size: 26rpx; }
.section-title { font-size: 30rpx; font-weight: bold; margin-bottom: 16rpx; }
.subject-row { padding: 12rpx 0; border-bottom: 1rpx solid #f5f5f5; }
.schedule-row { padding: 8rpx 0; color: #666; font-size: 26rpx; }
.review-item { padding: 16rpx 0; border-bottom: 1rpx solid #f5f5f5; }
.review-content { color: #666; margin-top: 8rpx; font-size: 26rpx; }
.empty-text { color: #999; font-size: 26rpx; }
.bottom-bar {
  position: fixed; bottom: 0; left: 0; right: 0;
  padding: 20rpx 32rpx; padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: #fff; box-shadow: 0 -2rpx 12rpx rgba(0,0,0,0.06);
}
.container { padding-bottom: 140rpx; }
