<view class="container">
  <!-- 筛选栏 -->
  <view class="filter-bar card anim-slide-up">
    <scroll-view scroll-x class="filter-scroll">
      <view
        wx:for="{{subjects}}"
        wx:key="*this"
        class="filter-item {{selectedSubject === item ? 'active' : ''}}"
        data-subject="{{item}}"
        bindtap="onSubjectTap"
      >{{item}}</view>
    </scroll-view>
    <scroll-view scroll-x class="filter-scroll">
      <view
        wx:for="{{gradeLevels}}"
        wx:key="*this"
        class="filter-item {{selectedGrade === item ? 'active' : ''}}"
        data-grade="{{item}}"
        bindtap="onGradeTap"
      >{{item}}</view>
    </scroll-view>
    <picker mode="selector" range="{{['评分最高','价格最低','经验最丰富']}}" bindchange="onSortChange">
      <view class="sort-btn">排序 ▼</view>
    </picker>
  </view>

  <!-- 错误态 -->
  <view wx:if="{{loadError}}" class="error-tip">
    <text>{{loadError}}</text>
    <view class="retry-btn" bindtap="onRetry">点此重试</view>
  </view>

  <!-- 骨架屏 -->
  <skeleton wx:if="{{loading && teachers.length === 0}}" type="card" count="4" />

  <!-- 空态 -->
  <view wx:if="{{teachers.length === 0 && !loading && !loadError}}" class="empty">
    <text class="empty-icon">📚</text>
    <text>暂无匹配教师</text>
    <text style="display:block;font-size:24rpx;margin-top:8rpx;color:#bbb;">试试调整筛选条件</text>
  </view>

  <!-- 教师卡片列表（带交错入场动画） -->
  <view
    wx:for="{{teachers}}"
    wx:key="id"
    class="teacher-card card"
    data-id="{{item.id}}"
    bindtap="goDetail"
    animation="{{item.animData}}"
  >
    <view class="flex-row">
      <image class="avatar" src="{{item.avatarUrl || '/assets/icons/user.png'}}" mode="aspectFill" lazy-load />
      <view class="teacher-info">
        <view class="flex-between">
          <text class="name">{{item.realName || item.nickname}}</text>
          <text class="rating">★ {{item.rating}} ({{item.reviewCount}})</text>
        </view>
        <view class="meta">{{item.education}} · {{item.teachingYears}}年教龄 · {{item.city || '全国'}}</view>
        <view class="tags">
          <text wx:for="{{item.subjects}}" wx:for-item="sub" wx:key="subject" class="tag">{{sub.subject}}</text>
        </view>
      </view>
    </view>
    <view class="flex-between price-row">
      <text class="style">{{item.teachingStyle || '耐心细致'}}</text>
      <text class="price">¥{{item.minPrice}}<text class="price-unit">/课时</text></text>
    </view>
  </view>

  <view wx:if="{{!hasMore && teachers.length > 0}}" class="empty">— 没有更多了 —</view>
</view>
