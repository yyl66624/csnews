<view class="container">
  <scroll-view scroll-x class="tabs anim-slide-up">
    <view
      wx:for="{{tabs}}"
      wx:key="key"
      class="tab {{activeTab === item.key ? 'active' : ''}}"
      data-key="{{item.key}}"
      bindtap="onTabTap"
    >{{item.label}}</view>
  </scroll-view>

  <!-- 骨架屏 -->
  <skeleton wx:if="{{loading && orders.length === 0}}" type="card" count="3" />

  <!-- 空态 -->
  <view wx:if="{{orders.length === 0 && !loading}}" class="empty">
    <text class="empty-icon">📋</text>
    <text>暂无订单</text>
  </view>

  <!-- 订单列表 -->
  <view wx:for="{{orders}}" wx:key="id" class="order-card card anim-slide-up" data-id="{{item.id}}" bindtap="goDetail">
    <view class="flex-between">
      <text class="order-no">{{item.orderNo}}</text>
      <text class="status">{{statusMap[item.status]}}</text>
    </view>
    <view class="order-info">
      <text>{{item.subject}} · {{item.gradeLevel}}</text>
    </view>
    <view class="order-info">{{item.lessonDate}} {{item.startTime}}-{{item.endTime}}</view>
    <view class="flex-between">
      <text class="teacher">{{item.teacherName}}</text>
      <text class="price">¥{{item.totalAmount}}</text>
    </view>
  </view>
</view>
