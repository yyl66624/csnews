.tabs { white-space: nowrap; margin-bottom: 20rpx; }
.tab {
  display: inline-block; padding: 12rpx 28rpx; margin-right: 12rpx;
  background: #fff; border-radius: 32rpx; font-size: 26rpx;
}
.tab.active { background: #4a90d9; color: #fff; }
.order-no { font-size: 24rpx; color: #999; }
.status { color: #4a90d9; font-size: 26rpx; }
.order-info { margin: 12rpx 0; color: #666; font-size: 26rpx; }
.teacher { color: #333; }
