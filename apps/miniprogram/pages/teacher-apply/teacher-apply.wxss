input, textarea { display: block; width: 100%; padding: 16rpx; margin: 12rpx 0; background: #f9f9f9; border-radius: 8rpx; box-sizing: border-box; }
.picker-row { padding: 20rpx 0; }
.slider-row { padding: 16rpx 0; }
.price-item { display: flex; gap: 8rpx; margin-bottom: 12rpx; }
.price-item input { flex: 1; margin: 0; }
.schedule-item { padding: 12rpx 0; color: #666; }
.btn-primary { margin-top: 32rpx; }
