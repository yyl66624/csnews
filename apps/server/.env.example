PORT=3000

# 数据库类型：mysql（推荐）| sqlite
DB_TYPE=mysql

# MySQL 配置
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_DATABASE=csnews

# SQLite 配置（DB_TYPE=sqlite 时使用）
DB_PATH=./data/csnews.sqlite

# Redis（可选，阶段 C3 教师列表缓存）
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=csnews-jwt-secret-change-in-production
JWT_EXPIRES_IN=7d

# 微信小程序
WX_APPID=your_wx_appid
WX_SECRET=your_wx_secret

# 微信支付 APIv3（阶段 A4，配置后启用真实支付）
WX_MCH_ID=your_mch_id
WX_MCH_SERIAL_NO=your_cert_serial_no
WX_API_V3_KEY=your_api_v3_key_32chars
# 商户私钥：二选一
WX_MCH_PRIVATE_KEY=
WX_MCH_PRIVATE_KEY_PATH=./certs/apiclient_key.pem
WX_NOTIFY_URL=https://your-domain.com/api/payments/notify
# 分账接收方商户号（可选）
WX_PROFIT_SHARING_RECEIVER=

# 腾讯云 COS（阶段 A5）
TX_COS_SECRET_ID=
TX_COS_SECRET_KEY=
TX_COS_BUCKET=
TX_COS_REGION=ap-guangzhou

# 平台手续费率（5%-9%）
SERVICE_FEE_RATE=0.07
