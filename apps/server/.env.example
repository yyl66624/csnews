PORT=3000

# 数据库类型：mysql（推荐）| sqlite
DB_TYPE=mysql

# MySQL 配置
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_DATABASE=csnews

# SQLite 配置（DB_TYPE=sqlite 时使用）
DB_PATH=./data/csnews.sqlite

# JWT
JWT_SECRET=csnews-jwt-secret-change-in-production
JWT_EXPIRES_IN=7d

# 微信小程序
WX_APPID=your_wx_appid
WX_SECRET=your_wx_secret

# 微信支付
WX_MCH_ID=your_mch_id
WX_MCH_KEY=your_mch_key
WX_NOTIFY_URL=https://your-domain.com/api/payments/notify

# 平台手续费率（5%-9%）
SERVICE_FEE_RATE=0.07
